# ---- Core ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Comma-separated list for several origins, e.g. https://app.example.com,https://staging.example.com

# ---- Neon PostgreSQL ----
# Pooled connection (host contains "-pooler") for application traffic:
DATABASE_URL=
# Direct (non-pooled) connection, used by `prisma migrate`:
DIRECT_DATABASE_URL=

# ---- Security ----
# At least 32 random characters: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
RATE_LIMIT_LOGIN_MAX=10

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- ANPR ----
# ocr = built-in Tesseract reads letters/digits from the photo (best effort, needs internet on first use).
# simulation = tests only (plate is typed). http = external recognition service.
ANPR_MODE=ocr
ANPR_SERVICE_URL=
ANPR_SERVICE_TOKEN=
ANPR_MIN_CONFIDENCE=0.85
ANPR_DEDUP_SECONDS=30

# ---- Payments ----
# simulation = development only. live = real provider adapter (must be implemented/configured).
PAYMENT_MODE=simulation
MOMO_API_BASE_URL=
MOMO_API_KEY=
MOMO_WEBHOOK_SECRET=

# ---- SMS ----
# simulation = messages are only recorded (NOT delivered). http = POST to SMS_API_URL with a bearer key.
# africastalking = real SMS through Africa's Talking (needs AT_USERNAME + AT_API_KEY from your account).
SMS_MODE=simulation
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=SmartParking

# ---- Gates ----
GATE_COMMAND_TIMEOUT_MS=4000

# ---- Seeding ----
# Production: set these to create the first super administrator (demo data is skipped in production).
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
# SEED_DEMO=true  # force demo data
# SEED_DEMO_PASSWORD=
